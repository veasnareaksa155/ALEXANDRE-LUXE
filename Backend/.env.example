APP_NAME="Alexandre Luxe"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-backend-domain.onrender.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Vercel Frontend Domain (Allowed in CORS)
FRONTEND_URL=https://your-alexandre-luxe.vercel.app

# Real Production Database (PostgreSQL / Supabase / Neon / Railway / Render DB)
DB_CONNECTION=pgsql
DB_HOST=your-db-host.supabase.co
DB_PORT=5432
DB_DATABASE=alexandre_luxe_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password

# National Bank of Cambodia Bakong Open API Credentials
BAKONG_API_URL=https://api-bakong.nbc.gov.kh/v1
BAKONG_TOKEN=your_nbc_bakong_open_api_token
BAKONG_MERCHANT_ID=alexandre_luxe@acleda
BAKONG_MERCHANT_NAME="ALEXANDRE LUXE ATELIER"
BAKONG_STORE_LABEL="Phnom Penh Store"
BAKONG_TERMINAL=WEB-STORE

SESSION_DRIVER=database
SESSION_LIFETIME=120
